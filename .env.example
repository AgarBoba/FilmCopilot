REPLICATE_API_TOKEN=
CANVAS_DATA_DIR=./data
CANVAS_DATABASE_PATH=./data/canvas.sqlite3
API_PORT=8000
WEB_PORT=5173

# Agent：二选一
# 1) Claude 订阅额度（Pro / Max / Team / Enterprise，仅限自己用）：
#    运行 ./scripts/claude-login.sh 拿到令牌，填在下面，并把 AGENT_AUTH 设成 subscription
# 2) API Key 按量计费：填 ANTHROPIC_API_KEY，AGENT_AUTH 设成 api
AGENT_AUTH=subscription
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# 默认模型（面板里可以随时切换）：claude-opus-5-5 / claude-sonnet-5 / claude-haiku-4-5-20251001
AGENT_MODEL=claude-opus-5-5
