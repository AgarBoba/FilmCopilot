# Film Copilot 本地设置。密钥只放在这个文件里（.env 不进 git），不要发到聊天里。
# 改完要重启 ./scripts/dev.sh 才生效。

# 画布里的 Agent：Anthropic API Key（https://console.anthropic.com → API Keys）
ANTHROPIC_API_KEY=
# 默认模型（面板里可以随时切换）：claude-opus-5-5 / claude-sonnet-5 / claude-haiku-4-5-20251001
AGENT_MODEL=claude-opus-5-5

# 生成模型的密钥：models/*.json 里每个 "provider" 需要自己的 key。
# Replicate（默认的 Seedream 5 Pro / Seedance 2.0 Mini）：https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

CANVAS_DATA_DIR=./data
CANVAS_DATABASE_PATH=./data/canvas.sqlite3
API_PORT=8000
WEB_PORT=5173
