{
  "id": "seedance-2.5",
  "label": "Seedance 2.5",
  "kind": "video",
  "provider": "replicate",
  "providerModel": "bytedance/seedance-2.5",
  "default": false,
  "description": "字节跳动 Seedance 旗舰视频模型（全能参考）：一次最长 30 秒，最多参考 30 张图和 10 段视频，带同步声音；也能按提示词编辑或延长参考视频。比 2.0 Mini 贵很多。",
  "family": "seedance-2.5",
  "capabilities": ["omni_reference", "text_to_video", "reference_video", "audio"],
  "checks": [
    { "rule": "aspect_range", "min": 0.4, "max": 2.5 },
    { "rule": "side_range", "min": 300, "max": 6000 },
    { "rule": "aspect_range", "target": "videos", "min": 0.4, "max": 2.5 },
    { "rule": "side_range", "target": "videos", "min": 300, "max": 6000 },
    { "rule": "pixel_range", "target": "videos", "min": 407696, "max": 8295044 },
    { "rule": "duration_range", "target": "videos", "min": 2, "max": 30 },
    { "rule": "total_duration", "target": "videos", "max": 30 }
  ],
  "credits": { "base": 116, "multiply": {
    "duration": { "-1": 2, "10": 2, "15": 3, "20": 4, "30": 6 },
    "resolution": { "480p": 0.45 } } },
  "inputs": {
    "prompt": "prompt",
    "images": { "field": "reference_images", "max": 30 },
    "videos": { "field": "reference_videos", "max": 10 }
  },
  "parameters": [
    { "key": "duration", "label": "Duration", "type": "enum", "field": "duration", "default": 5,
      "options": [{ "value": 5, "label": "5s" }, { "value": 10, "label": "10s" }, { "value": 15, "label": "15s" },
                  { "value": 20, "label": "20s" }, { "value": 30, "label": "30s" }, { "value": -1, "label": "Auto" }] },
    { "key": "resolution", "label": "Resolution", "type": "enum", "field": "resolution", "default": "720p",
      "options": [{ "value": "480p", "label": "480p" }, { "value": "720p", "label": "720p" }] },
    { "key": "aspectRatio", "label": "Aspect ratio", "type": "enum", "field": "aspect_ratio", "default": "adaptive",
      "options": [
        { "value": "adaptive", "label": "Adaptive" }, { "value": "16:9", "label": "16:9" }, { "value": "9:16", "label": "9:16" },
        { "value": "4:3", "label": "4:3" }, { "value": "3:4", "label": "3:4" }, { "value": "1:1", "label": "1:1" },
        { "value": "21:9", "label": "21:9" }
      ] },
    { "key": "generateAudio", "label": "Audio", "type": "boolean", "field": "generate_audio", "default": true }
  ]
}
